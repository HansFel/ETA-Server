SECRET_KEY_FILE=/run/secrets/django-key
BOOTSTRAP_PASSWORD_FILE=/run/secrets/admin-password
BOOTSTRAP_USER=admin
INSTANCE_NAME=eta-docker-test
ETA_URL=http://192.168.178.22:8080
POLL_SECONDS=30
# Alte Werte in 5-Minuten-Blöcken verdichten, Originalwerte komprimiert erhalten.
ARCHIVE_ENABLED=1
ARCHIVE_AFTER_DAYS=30
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_URL=http://localhost:8098
# Optional extra CSRF-trusted origins (comma separated), e.g. when the app is
# reached over another hostname/IP. The app already tolerates opaque "null" origins.
#CSRF_TRUSTED_ORIGINS=http://heiz.example.at
COOKIE_SECURE=0
# Optional, for password recovery and invitations; no emails sent without configuration.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=heizung@example.invalid
# MQTT-Brücke: Geräte/Aufgaben schalten über die App. Leer = aus. NAS: MQTT_HOST=mosquitto (Netz "mqtt").
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=eta-app
MQTT_PASSWORD_FILE=/run/secrets/mqtt-app-password
# Befehle mit älterem Zeitstempel (Sekunden) werden abgewiesen.
MQTT_COMMAND_MAX_AGE=120
